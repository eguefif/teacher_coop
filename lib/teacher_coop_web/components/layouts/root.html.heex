<!DOCTYPE html>
<html lang={Gettext.get_locale()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="TeacherCoop" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const getTheme = (preference) => preference == "dark" ? "sunset" : "nord";

        const setTheme = (theme) => {
          if (theme === "system") {
            const theme = getTheme(systemTheme());
            localStorage.removeItem("phx:theme");
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-source", "system");
          } else {
            const theme = getTheme(theme);
            localStorage.setItem("phx:theme", theme);
            document.documentElement.setAttribute("data-theme", theme);
            document.documentElement.setAttribute("data-theme-source", "user");
          }
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));
        
        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", systemTheme());
          }
        });
      })();
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <div class="flex flex-row gap-8 space-between m-4 max-w-250 mx-auto items-baseline">
      <div class="text-xl min-w-50">
        <.link href={~p"/"}>
          Teacher Coop
        </.link>
      </div>
      <ul class="menu menu-horizontal w-full relative z-10 flex items-center gap-4 px-4 sm:px-6 lg:px-8 justify-end">
        <%= if @current_scope do %>
          <li>
            {@current_scope.user.email}
          </li>
          <%= if TeacherCoop.Accounts.Scope.is_admin?(@current_scope) do %>
            <li>
              <details>
                <summary><.link href={~p"/admin/"}>{gettext("Admin")}</.link></summary>
                <ul>
                  <li>
                    <.link href={~p"/admin/configurations"}>{gettext("Engine Configurations")}</.link>
                  </li>
                  <li>
                    <.link href={~p"/admin/indexes"}>{gettext("Indexes")}</.link>
                  </li>
                  <li>
                    <.link href={~p"/admin/oban"}>{gettext("Oban")}</.link>
                  </li>
                </ul>
              </details>
            </li>
          <% end %>
          <li>
            <.link href={~p"/documents"}>{gettext("Documents")}</.link>
          </li>
          <li>
            <.link href={~p"/users/settings"}>{gettext("Settings")}</.link>
          </li>
          <li>
            <.link href={~p"/users/log-out"} method="delete">{gettext("Log out")}</.link>
          </li>
        <% else %>
          <li>
            <.link href={~p"/users/register"}>{gettext("Register")}</.link>
          </li>
          <li>
            <.link href={~p"/users/log-in"}>{gettext("Log in")}</.link>
          </li>
        <% end %>
        <li>
          <details id="locale-switcher">
            <summary>
              <.icon name="hero-language" class="size-4" />
              {String.upcase(Gettext.get_locale())}
            </summary>
            <ul class="right-0">
              <li>
                <.link id="locale-fr" href={~p"/locale/fr"} lang="fr">Français</.link>
              </li>
              <li>
                <.link id="locale-en" href={~p"/locale/en"} lang="en">English</.link>
              </li>
            </ul>
          </details>
        </li>
      </ul>
    </div>
    <div class="flex-1">
      {@inner_content}
    </div>
    <footer class="flex-0 footer sm:footer-horizontal bg-neutral text-neutral-content p-10 footer-center">
      <nav class="flex flex-row gap-8">
        <.link navigate={~p"/legal-mentions/"} class="link link-hover">{gettext("Legal Mentions")}</.link>
        <.link navigate={~p"/privacy-policy/"} class="link link-hover">{gettext("privacy policy")}</.link>
        <.link navigate={~p"/terms-of-service"} class="link link-hover">{gettext(
          "Terms of Service"
        )}</.link>
      </nav>
    </footer>
  </body>
</html>
