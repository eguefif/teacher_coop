<!DOCTYPE html>
<html lang={Gettext.get_locale()}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="csrf-token" content={get_csrf_token()} />
    <.live_title default="TeacherCoop" phx-no-format>{assigns[:page_title]}</.live_title>
    <link phx-track-static rel="stylesheet" href={~p"/assets/css/app.css"} />
    <script defer phx-track-static type="text/javascript" src={~p"/assets/js/app.js"}>
    </script>
    <script>
      (() => {
        const systemTheme = () => matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";

        const getTheme = (preference) => preference == "dark" ? "sunset" : "nord";

        const syncToggle = () => {
          const toggle = document.getElementById("theme-toggle");
          if (toggle) toggle.checked = document.documentElement.getAttribute("data-theme") === "sunset";
        };

        const setTheme = (preference) => {
          if (preference === "system") {
            localStorage.removeItem("phx:theme");
            document.documentElement.setAttribute("data-theme", getTheme(systemTheme()));
            document.documentElement.setAttribute("data-theme-source", "system");
          } else {
            localStorage.setItem("phx:theme", preference);
            document.documentElement.setAttribute("data-theme", getTheme(preference));
            document.documentElement.setAttribute("data-theme-source", "user");
          }
          syncToggle();
        };
        if (!document.documentElement.hasAttribute("data-theme")) {
          setTheme(localStorage.getItem("phx:theme") || "system");
        }
        window.addEventListener("storage", (e) => e.key === "phx:theme" && setTheme(e.newValue || "system"));

        window.addEventListener("phx:set-theme", (e) => setTheme(e.target.dataset.phxTheme));

        document.addEventListener("DOMContentLoaded", syncToggle);
        document.addEventListener("change", (e) => {
          if (e.target.id === "theme-toggle") setTheme(e.target.checked ? "dark" : "light");
        });

        matchMedia("(prefers-color-scheme: dark)").addEventListener("change", (e) => {
          if (document.documentElement.getAttribute("data-theme-source") === "system") {
            document.documentElement.setAttribute("data-theme", getTheme(systemTheme()));
            syncToggle();
          }
        });
      })();
    </script>
  </head>
  <body class="flex flex-col min-h-screen">
    <header class="navbar bg-base-100 shadow-sm px-4 lg:px-8 relative z-10">
      <div class="navbar-start">
        <div class="dropdown">
          <div
            id="mobile-menu-toggle"
            tabindex="0"
            role="button"
            aria-label={gettext("Menu")}
            class="btn btn-ghost lg:hidden"
          >
            <.icon name="hero-bars-3" class="size-5" />
          </div>
          <ul
            id="mobile-menu"
            tabindex="-1"
            class="menu menu-sm dropdown-content bg-base-100 rounded-box z-10 mt-3 w-60 p-2 shadow"
          >
            <%= if @current_scope do %>
              <li class="menu-title truncate">{@current_scope.user.email}</li>
              <li><.link href={~p"/documents"}>{gettext("Documents")}</.link></li>
              <%= if TeacherCoop.Accounts.Scope.is_admin?(@current_scope) do %>
                <li>
                  <.link href={~p"/admin/"}>{gettext("Admin")}</.link>
                  <ul class="p-2">
                    <li>
                      <.link href={~p"/admin/configurations"}>
                        {gettext("Engine Configurations")}
                      </.link>
                    </li>
                    <li><.link href={~p"/admin/indexes"}>{gettext("Indexes")}</.link></li>
                    <li><.link href={~p"/admin/curriculum"}>{gettext("Curriculum")}</.link></li>
                    <li>
                      <.link href={~p"/admin/oban"} target="_blank">{gettext("Oban")}</.link>
                    </li>
                    <li>
                      <.link href={~p"/admin/phoenix-dashboard"} target="_blank">{gettext(
                        "Phoenix Dashboard"
                      )}</.link>
                    </li>
                  </ul>
                </li>
              <% end %>
              <li><.link href={~p"/users/settings"}>{gettext("Settings")}</.link></li>
              <li>
                <.link href={~p"/users/log-out"} method="delete">{gettext("Log out")}</.link>
              </li>
            <% else %>
              <li><.link href={~p"/users/register"}>{gettext("Register")}</.link></li>
              <li><.link href={~p"/users/log-in"}>{gettext("Log in")}</.link></li>
            <% end %>
          </ul>
        </div>
        <.link href={~p"/"} class="btn btn-ghost text-xl">Teacher Coop</.link>
      </div>

      <nav class="navbar-center hidden lg:flex">
        <ul class="menu menu-horizontal px-1">
          <%= if @current_scope do %>
            <%= if TeacherCoop.Accounts.Scope.is_admin?(@current_scope) do %>
              <li>
                <details>
                  <summary>{gettext("Admin")}</summary>
                  <ul class="p-2 bg-base-100 w-56 z-10 shadow">
                    <li><.link href={~p"/admin/"}>{gettext("Dashboard")}</.link></li>
                    <li>
                      <.link href={~p"/admin/configurations"}>
                        {gettext("Engine Configurations")}
                      </.link>
                    </li>
                    <li><.link href={~p"/admin/indexes"}>{gettext("Indexes")}</.link></li>
                    <li><.link href={~p"/admin/curriculum"}>{gettext("Curriculum")}</.link></li>
                    <li>
                      <.link href={~p"/admin/oban"} target="_blank">{gettext("Oban")}</.link>
                    </li>
                    <li>
                      <.link href={~p"/admin/phoenix-dashboard"} target="_blank">{gettext(
                        "Phoenix Dashboard"
                      )}</.link>
                    </li>
                  </ul>
                </details>
              </li>
            <% end %>
            <li><.link href={~p"/documents"}>{gettext("Documents")}</.link></li>
          <% end %>
        </ul>
      </nav>

      <div class="navbar-end gap-2">
        <%= if @current_scope do %>
          <span class="hidden lg:inline text-sm opacity-70 truncate max-w-56">
            {@current_scope.user.email}
          </span>
          <.link href={~p"/users/settings"} class="btn btn-ghost btn-sm hidden lg:inline-flex">
            {gettext("Settings")}
          </.link>
          <.link
            href={~p"/users/log-out"}
            method="delete"
            class="btn btn-ghost btn-sm hidden lg:inline-flex"
          >
            {gettext("Log out")}
          </.link>
        <% else %>
          <.link href={~p"/users/log-in"} class="btn btn-ghost btn-sm hidden lg:inline-flex">
            {gettext("Log in")}
          </.link>
          <.link href={~p"/users/register"} class="btn btn-primary btn-sm hidden lg:inline-flex">
            {gettext("Register")}
          </.link>
        <% end %>
        <label
          id="theme-switcher"
          class="swap swap-rotate btn btn-ghost btn-circle btn-sm"
          aria-label={gettext("Toggle dark mode")}
        >
          <input id="theme-toggle" type="checkbox" class="theme-controller" value="sunset" />
          <svg
            class="swap-off size-5 fill-current"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M5.64,17l-.71.71a1,1,0,0,0,0,1.41,1,1,0,0,0,1.41,0l.71-.71A1,1,0,0,0,5.64,17ZM5,12a1,1,0,0,0-1-1H3a1,1,0,0,0,0,2H4A1,1,0,0,0,5,12Zm7-7a1,1,0,0,0,1-1V3a1,1,0,0,0-2,0V4A1,1,0,0,0,12,5ZM5.64,7.05a1,1,0,0,0,.7.29,1,1,0,0,0,.71-.29,1,1,0,0,0,0-1.41l-.71-.71A1,1,0,0,0,4.93,6.34Zm12,.29a1,1,0,0,0,.7-.29l.71-.71a1,1,0,1,0-1.41-1.41L17,5.64a1,1,0,0,0,0,1.41A1,1,0,0,0,17.66,7.34ZM21,11H20a1,1,0,0,0,0,2h1a1,1,0,0,0,0-2Zm-9,8a1,1,0,0,0-1,1v1a1,1,0,0,0,2,0V20A1,1,0,0,0,12,19ZM18.36,17A1,1,0,0,0,17,18.36l.71.71a1,1,0,0,0,1.41,0,1,1,0,0,0,0-1.41ZM12,6.5A5.5,5.5,0,1,0,17.5,12,5.51,5.51,0,0,0,12,6.5Zm0,9A3.5,3.5,0,1,1,15.5,12,3.5,3.5,0,0,1,12,15.5Z" />
          </svg>
          <svg
            class="swap-on size-5 fill-current"
            xmlns="http://www.w3.org/2000/svg"
            viewBox="0 0 24 24"
            aria-hidden="true"
          >
            <path d="M21.64,13a1,1,0,0,0-1.05-.14,8.05,8.05,0,0,1-3.37.73A8.15,8.15,0,0,1,9.08,5.49a8.59,8.59,0,0,1,.25-2A1,1,0,0,0,8,2.36,10.14,10.14,0,1,0,22,14.05,1,1,0,0,0,21.64,13Zm-9.5,6.69A8.14,8.14,0,0,1,7.08,5.22v.27A10.15,10.15,0,0,0,17.22,15.63a9.79,9.79,0,0,0,2.1-.22A8.11,8.11,0,0,1,12.14,19.73Z" />
          </svg>
        </label>
        <ul class="menu menu-horizontal px-1">
          <li>
            <details id="locale-switcher">
              <summary>
                <.icon name="hero-language" class="size-4" />
                {String.upcase(Gettext.get_locale())}
              </summary>
              <ul class="right-0 p-2 bg-base-100 w-36 z-10 shadow">
                <li>
                  <.link id="locale-fr" href={~p"/locale/fr"} lang="fr">Français</.link>
                </li>
                <li>
                  <.link id="locale-en" href={~p"/locale/en"} lang="en">English</.link>
                </li>
              </ul>
            </details>
          </li>
        </ul>
      </div>
    </header>
    <div class="flex-1">
      {@inner_content}
    </div>
    <footer class="flex-0 flex flex-col sm:flex-row items-center sm:justify-between gap-2 px-6 py-3 text-sm bg-base-200">
      <nav class="flex flex-row flex-wrap justify-center gap-x-6 gap-y-1">
        <.link navigate={~p"/legal-mentions/"} class="link link-hover">{gettext("Legal Mentions")}</.link>
        <.link navigate={~p"/privacy-policy/"} class="link link-hover">{gettext("Privacy Policy")}</.link>
        <.link navigate={~p"/terms-of-service"} class="link link-hover">{gettext(
          "Terms of Service"
        )}</.link>
      </nav>
      <aside
        id="footer-copyright"
        class="flex flex-row flex-wrap justify-center gap-2 opacity-70"
      >
        <span>© 2026 Emmanuel Guefif</span>
        <span aria-hidden="true">·</span>
        <a
          id="footer-source-code"
          href="https://github.com/eguefif/teacher_coop"
          target="_blank"
          rel="noopener noreferrer"
          class="link link-hover"
        >
          {gettext("Source code")}
        </a>
        <span aria-hidden="true">·</span>
        <a
          id="footer-licence"
          href="https://www.gnu.org/licenses/agpl-3.0.html"
          target="_blank"
          rel="noopener noreferrer"
          class="link link-hover"
        >
          {gettext("AGPL-3.0 licence")}
        </a>
      </aside>
    </footer>
  </body>
</html>
